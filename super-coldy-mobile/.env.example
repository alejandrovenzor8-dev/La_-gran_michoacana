# ============================================================
# Configuración del Frontend Mobile - Super Coldy
# ============================================================

# Copiar a .env.local o actualizar src/config/api.config.ts

# ============================================================
# API Configuration
# ============================================================

# URL del backend API
# Para desarrollo:
#   - Local: http://192.168.1.X:3000/api (reemplaza X con tu IP local)
#   - En la misma máquina: http://localhost:3000/api
# Para producción:
#   - Railway: https://tu-app.up.railway.app/api

API_BASE_URL=https://la-granmichoacana-production.up.railway.app/api

# Timeout para peticiones (en ms)
API_TIMEOUT=10000

# ============================================================
# Desarrollo Local
# ============================================================

# Para probar localmente, descomenta y ajusta la IP:
# API_BASE_URL=http://192.168.1.100:3000/api

# Obtén tu IP local:
# - Windows: ipconfig (busca "IPv4 Address")
# - macOS/Linux: ifconfig | grep inet

# ============================================================
# Environment
# ============================================================

# development | production
ENVIRONMENT=production

# ============================================================
# Logging y Debug
# ============================================================

# Habilitar logs detallados
DEBUG_MODE=false

# ============================================================
# Notificaciones
# ============================================================

# Token para notificaciones push (si aplica)
# PUSH_NOTIFICATION_TOKEN=

# ============================================================
# Analytics (opcional)
# ============================================================

# Clave para analíticas si lo necesitas
# ANALYTICS_KEY=

# ============================================================
# INSTRUCCIONES DE SETUP
# ============================================================

# 1. Obtén tu IP local (si usas desarrollo local):
#    Windows: Abre CMD y ejecuta: ipconfig
#    Busca la línea "IPv4 Address" (ej: 192.168.1.100)
#
# 2. Asume que el backend corre en http://tu-ip:3000
#
# 3. Actualiza API_BASE_URL con http://tu-ip:3000/api
#
# 4. Prueba la conexión desde el móvil accediendo a:
#    http://tu-ip:3000/health
#    Deberías ver: { "status": "OK", ... }
#
# 5. En el código, verifica src/config/api.config.ts

