generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  email         String         @unique
  password      String
  role          Role           @default(CASHIER)
  branchId      String
  branch        Branch         @relation(fields: [branchId], references: [id])
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sales         Sale[]
  cashRegisters CashRegister[]

  @@map("users")
}

model Branch {
  id         String      @id @default(uuid())
  name       String
  address    String
  phone      String
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  users      User[]
  products   Product[]
  inventory  Inventory[]
  sales      Sale[]
  cashRegisters CashRegister[]

  @@map("branches")
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String?
  price       Float
  cost        Float
  category    String
  imageUrl    String?
  isActive    Boolean     @default(true)
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventory   Inventory[]
  saleItems   SaleItem[]

  @@map("products")
}

model Inventory {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id])
  stock           Int       @default(0)
  minStock        Int       @default(5)
  maxStock        Int       @default(100)
  lastRestockDate DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([productId, branchId])
  @@map("inventory")
}

model Sale {
  id              String        @id @default(uuid())
  total           Float
  subtotal        Float
  tax             Float         @default(0)
  discount        Float         @default(0)
  paymentMethod   PaymentMethod
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  cashRegisterId  String
  cashRegister    CashRegister  @relation(fields: [cashRegisterId], references: [id])
  items           SaleItem[]
  createdAt       DateTime      @default(now())

  @@map("sales")
}

model SaleItem {
  id         String   @id @default(uuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Float
  subtotal   Float
  toppings   String[] @default([])
  notes      String?

  @@map("sale_items")
}

model CashRegister {
  id           String            @id @default(uuid())
  branchId     String
  branch       Branch            @relation(fields: [branchId], references: [id])
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  openingCash  Float
  closingCash  Float?
  expectedCash Float?
  difference   Float?
  status       CashRegisterStatus @default(OPEN)
  openedAt     DateTime          @default(now())
  closedAt     DateTime?
  sales        Sale[]

  @@map("cash_registers")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}
