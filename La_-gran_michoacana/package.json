{
  "name": "la-gran-michoacana-pos",
  "version": "1.1.2",
  "description": "Sistema POS para La Gran Michoacana con doble pantalla",
  "main": "dist-electron/main.js",
  "author": "La Gran Michoacana",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "npm run build:electron && vite build && electron-builder",
    "build:win": "set CSC_IDENTITY_AUTO_DISCOVERY=false && npm run build:electron && vite build && electron-builder --win",
    "build:publish": "set CSC_IDENTITY_AUTO_DISCOVERY=false && npm run build:electron && vite build && electron-builder --win --publish always",
    "preview": "vite preview",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron ."
  },
  "dependencies": {
    "@radix-ui/react-radio-group": "^1.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "electron-log": "^5.4.3",
    "electron-pos-printer": "^1.3.8",
    "electron-updater": "^6.7.3",
    "framer-motion": "^11.0.3",
    "lucide-react": "^0.314.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^40.1.0",
    "electron-builder": "^26.6.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.lagranmichoacana.pos",
    "productName": "La Gran Michoacana",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraFiles": [
      {
        "from": "dist/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "dist/logo.png",
        "to": "logo.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "La Gran Michoacana",
      "allowElevation": true,
      "perMachine": true
    },
    "publish": {
      "provider": "github",
      "owner": "alejandrovenzor8-dev",
      "repo": "La_-gran_michoacana"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/app-icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/app-icon.png"
    }
  }
}
