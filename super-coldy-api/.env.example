# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# LOCAL: postgresql://usuario:password@localhost:5432/supercoldy_pos?schema=public
# RAILWAY: Obtén la URL de Railway > Tu Servicio PostgreSQL > Variables > DATABASE_URL
DATABASE_URL="postgresql://usuario:password@localhost:5432/supercoldy_pos?schema=public"

# JWT Configuration
JWT_SECRET=tu_secreto_super_seguro_cambiar_en_produccion
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=otro_secreto_diferente_para_refresh
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ============================================================
# EXPLICACIÓN DE VARIABLES DE ENTORNO
# ============================================================
# PORT: Puerto donde correrá el servidor
#   Cambiar en producción si es necesario
#
# NODE_ENV: Ambiente de ejecución
#   Valores: development, production, test
#   Afecta comportamiento de logging y validaciones
#
# DATABASE_URL: URL de conexión a PostgreSQL
#   Formato: postgresql://usuario:password@host:puerto/base_datos?schema=public
#   Reemplazar: usuario, password, localhost, puerto y nombre BD
#
# JWT_SECRET: Secreto para firmar tokens de acceso JWT
#   ⚠️ CRÍTICO: Cambiar a un valor seguro en producción
#   Usar: openssl rand -base64 32
#
# JWT_EXPIRES_IN: Tiempo de expiración del token de acceso
#   Ejemplos válidos: 1h, 24h, 7d, 30m
#   Recomendar corta duración para acceso (24h o menos)
#
# JWT_REFRESH_SECRET: Secreto para firmar tokens de refresco
#   ⚠️ CRÍTICO: Debe ser diferente a JWT_SECRET
#   Usar: openssl rand -base64 32
#
# JWT_REFRESH_EXPIRES_IN: Tiempo de expiración del token de refresco
#   Usar duración mayor que acceso (típicamente 7d o 30d)
#
# CORS_ORIGIN: Orígenes permitidos para CORS
#   URLs separadas por coma
#   http://localhost:5173 - Cliente Electron en desarrollo
#   http://localhost:3000 - Posibles otros clientes
#   En producción especificar origen exacto
#
# NOTA: Para usar este archivo:
# 1. Copia este archivo a .env
# 2. Reemplaza los valores por los reales
# 3. NUNCA commitear .env en git
# 4. En producción usar variables de sistema/secretos seguros

