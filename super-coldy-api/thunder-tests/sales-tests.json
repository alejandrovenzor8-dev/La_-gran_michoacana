{
  "info": {
    "name": "La Michoacana POS - Sales Module",
    "description": "Collection of API requests for testing the Sales module",
    "version": "1.0.0"
  },
  "requests": [
    {
      "name": "POST Create Sale - Efectivo",
      "method": "POST",
      "url": "{{baseUrl}}/api/sales",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer {{accessToken}}"
      },
      "body": {
        "items": [
          {
            "productId": "PRODUCT_ID_1",
            "productName": "Paleta de Fresa",
            "quantity": 2,
            "unitPrice": 15,
            "subtotal": 30,
            "discount": 0
          },
          {
            "productId": "PRODUCT_ID_2",
            "productName": "Paleta de Mango",
            "quantity": 1,
            "unitPrice": 15,
            "subtotal": 15,
            "discount": 0
          }
        ],
        "paymentMethod": "EFECTIVO",
        "amountReceived": 50,
        "discount": 0,
        "tax": 0,
        "notes": "Venta de prueba - Efectivo",
        "source": "DESKTOP"
      },
      "tests": [
        {
          "name": "Status is 201",
          "expect": "{{response.status}} == 201"
        },
        {
          "name": "Success is true",
          "expect": "{{response.data.success}} == true"
        }
      ]
    },
    {
      "name": "POST Create Sale - Tarjeta",
      "method": "POST",
      "url": "{{baseUrl}}/api/sales",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer {{accessToken}}"
      },
      "body": {
        "items": [
          {
            "productId": "PRODUCT_ID_3",
            "productName": "Raspado de Limón",
            "quantity": 3,
            "unitPrice": 20,
            "subtotal": 60,
            "discount": 0
          }
        ],
        "paymentMethod": "TARJETA",
        "discount": 5,
        "tax": 0,
        "notes": "Venta con descuento",
        "source": "DESKTOP"
      },
      "tests": [
        {
          "name": "Status is 201",
          "expect": "{{response.status}} == 201"
        },
        {
          "name": "Has sale ID",
          "expect": "{{response.data.data.id}} != ''"
        }
      ]
    },
    {
      "name": "GET All Sales",
      "method": "GET",
      "url": "{{baseUrl}}/api/sales?page=1&limit=10",
      "headers": {
        "Authorization": "Bearer {{accessToken}}"
      },
      "tests": [
        {
          "name": "Status is 200",
          "expect": "{{response.status}} == 200"
        },
        {
          "name": "Has pagination data",
          "expect": "{{response.data.data.pagination.total}} >= 0"
        }
      ]
    },
    {
      "name": "GET All Sales with Filters",
      "method": "GET",
      "url": "{{baseUrl}}/api/sales?paymentMethod=EFECTIVO&status=COMPLETED&page=1&limit=10",
      "headers": {
        "Authorization": "Bearer {{accessToken}}"
      },
      "tests": [
        {
          "name": "Status is 200",
          "expect": "{{response.status}} == 200"
        }
      ]
    },
    {
      "name": "GET Sale by ID",
      "method": "GET",
      "url": "{{baseUrl}}/api/sales/SALE_ID",
      "headers": {
        "Authorization": "Bearer {{accessToken}}"
      },
      "tests": [
        {
          "name": "Status is 200 or 404",
          "expect": "{{response.status}} == 200 || {{response.status}} == 404"
        }
      ]
    },
    {
      "name": "GET Daily Report",
      "method": "GET",
      "url": "{{baseUrl}}/api/sales/daily",
      "headers": {
        "Authorization": "Bearer {{accessToken}}"
      },
      "tests": [
        {
          "name": "Status is 200",
          "expect": "{{response.status}} == 200"
        },
        {
          "name": "Has stats",
          "expect": "{{response.data.data.stats}} != null"
        }
      ]
    },
    {
      "name": "GET Daily Report - Specific Date",
      "method": "GET",
      "url": "{{baseUrl}}/api/sales/daily?date=2026-02-10",
      "headers": {
        "Authorization": "Bearer {{accessToken}}"
      },
      "tests": [
        {
          "name": "Status is 200",
          "expect": "{{response.status}} == 200"
        }
      ]
    },
    {
      "name": "GET Sales Stats",
      "method": "GET",
      "url": "{{baseUrl}}/api/sales/stats",
      "headers": {
        "Authorization": "Bearer {{accessToken}}"
      },
      "tests": [
        {
          "name": "Status is 200",
          "expect": "{{response.status}} == 200"
        },
        {
          "name": "Has totalRevenue",
          "expect": "{{response.data.data.totalRevenue}} >= 0"
        }
      ]
    },
    {
      "name": "GET Sales Stats - Date Range",
      "method": "GET",
      "url": "{{baseUrl}}/api/sales/stats?startDate=2026-02-01&endDate=2026-02-10",
      "headers": {
        "Authorization": "Bearer {{accessToken}}"
      },
      "tests": [
        {
          "name": "Status is 200",
          "expect": "{{response.status}} == 200"
        }
      ]
    },
    {
      "name": "PUT Cancel Sale",
      "method": "PUT",
      "url": "{{baseUrl}}/api/sales/SALE_ID/cancel",
      "headers": {
        "Authorization": "Bearer {{accessToken}}"
      },
      "tests": [
        {
          "name": "Status is 200 or 404",
          "expect": "{{response.status}} == 200 || {{response.status}} == 404"
        }
      ]
    }
  ],
  "variables": {
    "baseUrl": "http://localhost:8080",
    "accessToken": ""
  }
}
